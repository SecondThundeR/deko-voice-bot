{
    "name": "deko-voice-bot",
    "version": "3.9.0",
    "type": "module",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": ">=24.19.0"
    },
    "scripts": {
        "dev": "pnpm --filter @deko-voice-bot/bot dev",
        "dev:operations": "pnpm --filter @deko-voice-bot/operations dev",
        "build": "pnpm --filter @deko-voice-bot/bot build && pnpm --filter @deko-voice-bot/operations build",
        "build:bot": "pnpm --filter @deko-voice-bot/bot build",
        "start": "pnpm --filter @deko-voice-bot/bot start",
        "start:operations": "pnpm --filter @deko-voice-bot/operations start",
        "test": "node --test",
        "typecheck": "tsc",
        "lint": "biome check",
        "lint:write": "biome check --write",
        "format": "biome format --write .",
        "backup:crypto": "pnpm --filter @deko-voice-bot/backup crypto",
        "db:generate": "pnpm --filter @deko-voice-bot/bot db:generate",
        "db:migrate": "pnpm --filter @deko-voice-bot/bot db:migrate"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.8",
        "@types/node": "26.2.0",
        "drizzle-kit": "0.31.10",
        "tsdown": "0.22.14",
        "typescript": "7.0.2"
    }
}
