{
    "name": "deko-voice-bot",
    "version": "3.9.2",
    "type": "module",
    "private": true,
    "module": "src/main.ts",
    "license": "MIT",
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": ">=24.22.0"
    },
    "imports": {
        "#root/*.js": "./src/*.ts",
        "#root/*": "./src/*.ts",
        "#drizzle/*.js": "./drizzle/*.ts",
        "#drizzle/*": "./drizzle/*.ts"
    },
    "scripts": {
        "dev": "NODE_ENV=development node --watch ./src/main.ts",
        "build": "tsdown --config tsdown.config.ts",
        "start": "NODE_ENV=production node ./dist/main.mjs",
        "start:backup-cron": "NODE_ENV=production node ./dist/backup-cron.mjs",
        "test": "node --test",
        "typecheck": "tsc",
        "lint": "biome check",
        "lint:write": "biome check --write",
        "format": "biome format --write .",
        "backup:crypto": "node ./scripts/backup-crypto.ts",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts",
        "db:migrate": "node ./drizzle/migrate.ts"
    },
    "dependencies": {
        "@grammyjs/auto-chat-action": "0.1.1",
        "@grammyjs/commands": "1.4.0",
        "@grammyjs/conversations": "2.1.1",
        "@grammyjs/hydrate": "1.7.0",
        "@grammyjs/i18n": "1.1.2",
        "@grammyjs/menu": "1.5.0",
        "@grammyjs/parse-mode": "1.11.1",
        "@grammyjs/runner": "2.0.3",
        "@hono/node-server": "2.1.5",
        "callback-data": "1.1.1",
        "drizzle-orm": "0.45.4",
        "grammy": "1.46.0",
        "hono": "4.13.13",
        "pino": "10.4.0",
        "pino-pretty": "13.2.0",
        "postgres": "3.4.9",
        "valibot": "1.5.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@types/node": "26.6.5",
        "drizzle-kit": "0.31.11",
        "tsdown": "0.23.1",
        "typescript": "7.0.2"
    }
}
