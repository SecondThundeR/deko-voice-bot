{
    "name": "deko-voice-bot",
    "version": "3.10.0",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": ">=24.19.0",
        "pnpm": ">=11.21.0"
    },
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "lint": "turbo run lint",
        "lint:write": "turbo run lint:write",
        "format": "turbo run format",
        "start:bot": "pnpm --filter @deko-voice-bot/bot start",
        "start:api": "pnpm --filter @deko-voice-bot/api start",
        "backup:crypto": "pnpm --filter @deko-voice-bot/bot backup:crypto",
        "queue:replay": "pnpm --filter @deko-voice-bot/bot queue:replay",
        "db:generate": "pnpm --filter @deko-voice-bot/database db:generate",
        "db:migrate": "pnpm --filter @deko-voice-bot/database db:migrate",
        "db:check": "pnpm --filter @deko-voice-bot/database db:check"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.8",
        "turbo": "2.10.7",
        "typescript": "7.0.2"
    }
}
