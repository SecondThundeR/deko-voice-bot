{
    "name": "@deko-voice-bot/api",
    "version": "3.10.0",
    "private": true,
    "type": "module",
    "imports": {
        "#root/*.js": "./src/*.ts",
        "#root/*": "./src/*.ts"
    },
    "scripts": {
        "dev": "NODE_ENV=development node --watch ./src/index.ts",
        "build": "tsdown",
        "start": "NODE_ENV=production node ./dist/index.mjs",
        "test": "node --test",
        "typecheck": "tsc",
        "lint": "biome check",
        "lint:write": "biome check --write",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@deko-voice-bot/application": "workspace:*",
        "@deko-voice-bot/audio": "workspace:*",
        "@deko-voice-bot/config": "workspace:*",
        "@deko-voice-bot/contracts": "workspace:*",
        "@deko-voice-bot/database": "workspace:*",
        "@deko-voice-bot/metrics": "workspace:*",
        "@hono/node-server": "catalog:",
        "hono": "catalog:",
        "ioredis": "6.0.0",
        "pino": "catalog:",
        "pino-pretty": "catalog:",
        "valibot": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "tsdown": "catalog:"
    }
}
