BOT_TOKEN=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db
VOICE_MODERATION_CHAT_ID=-1001234567890
ADMIN_IDS=[]
PORT=3000
LOG_LEVEL=info
LOG_FORMAT=pretty
# Comma-separated exact browser origins for a separately hosted frontend.
# Leave empty when the Mini App reaches the API through its same-origin /api proxy.
API_CORS_ORIGINS=
# The API sits behind the web/Nginx proxy by default, so its socket peer is not
# the user. Enable this only when the API receives verified client IP addresses.
API_IP_RATE_LIMIT_ENABLED=false
# memory is single-instance only. Set redis plus REDIS_URL for distributed enforcement.
API_RATE_LIMIT_BACKEND=memory
REDIS_URL=
# Disabled by default. When enabled, /metrics requires this 32+ character bearer token.
API_METRICS_ENABLED=false
API_METRICS_TOKEN=
