{
    "name": "@deko-voice-bot/bot",
    "version": "3.9.0",
    "type": "module",
    "private": true,
    "module": "src/main.ts",
    "imports": {
        "#root/*.js": "./src/*.ts",
        "#root/*": "./src/*.ts",
        "#drizzle/*.js": "./drizzle/*.ts",
        "#drizzle/*": "./drizzle/*.ts"
    },
    "scripts": {
        "dev": "NODE_ENV=development node --watch ./src/main.ts",
        "build": "tsdown --config tsdown.config.ts",
        "start": "NODE_ENV=production node ./dist/main.mjs",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts",
        "db:migrate": "node ./drizzle/migrate.ts"
    },
    "dependencies": {
        "@deko-voice-bot/backup": "workspace:*",
        "@deko-voice-bot/contract": "workspace:*",
        "@deko-voice-bot/shared": "workspace:*",
        "@grammyjs/auto-chat-action": "0.1.1",
        "@grammyjs/commands": "1.4.0",
        "@grammyjs/conversations": "2.1.1",
        "@grammyjs/hydrate": "1.7.0",
        "@grammyjs/i18n": "1.1.2",
        "@grammyjs/menu": "1.4.0",
        "@grammyjs/parse-mode": "1.11.1",
        "@grammyjs/runner": "2.0.3",
        "@hono/node-server": "2.1.0",
        "callback-data": "1.1.1",
        "drizzle-orm": "0.45.2",
        "grammy": "1.45.1",
        "hono": "4.13.1",
        "pino": "10.3.1",
        "pino-pretty": "13.1.3",
        "postgres": "3.4.9",
        "valibot": "1.4.2"
    }
}
