        "clsx": "2.1.1",
        "lucide-react": "1.31.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "shadcn": "4.17.0",
        "sonner": "2.0.8",
        "tailwind-merge": "3.6.0",
